# Tailscale Configuration
TS_AUTHKEY=tskey-auth-xxxxxx
TS_CERT_DOMAIN=tax-dashboard-server.tailnet-xxxx.ts.net

# Flask Tax Dashboard
FLASK_SECRET_KEY=super-secret-key-change-me

# PostgreSQL (Used by Flask Dashboard & Paperless-ngx)
POSTGRES_PASSWORD=postgres-secret-change-me

# MariaDB (Used by Invoice Ninja)
MYSQL_ROOT_PASSWORD=mariadb-root-secret-change-me
MYSQL_PASSWORD=mariadb-user-secret-change-me

# Invoice Ninja Config
INVOICE_NINJA_DOMAIN=invoiceninja.local
INVOICE_NINJA_APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx=
